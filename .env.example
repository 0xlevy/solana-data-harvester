# ═══════════════════════════════════════════════════════════════════════
# AUTONOMOUS SOLANA DATA HARVESTER - ENVIRONMENT CONFIGURATION
# Colosseum Agent Hackathon 2026
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# HELIUS API (Required for enhanced RPC features)
# Get your free key at: https://www.helius.dev/
# ─────────────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here

# ─────────────────────────────────────────────────────────────────────────
# AGENTWALLET INTEGRATION (Hackathon Requirement)
# Docs: https://agentwallet.mcpay.tech/api
# IMPORTANT: Never manage raw Solana keys yourself - use AgentWallet!
# ─────────────────────────────────────────────────────────────────────────
AGENTWALLET_API_KEY=your_agentwallet_api_key_here

# ─────────────────────────────────────────────────────────────────────────
# COLOSSEUM HACKATHON API (Required for submission)
# Get your key from: https://agents.colosseum.com/api
# ─────────────────────────────────────────────────────────────────────────
COLOSSEUM_API_KEY=your_colosseum_api_key_here

# ─────────────────────────────────────────────────────────────────────────
# SOLANA RPC CONFIGURATION
# Options: mainnet-beta, devnet, or custom RPC URL
# For hackathon testing, use devnet first
# ─────────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# ─────────────────────────────────────────────────────────────────────────
# AGENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
COLLECTION_INTERVAL_SECONDS=300
DATA_OUTPUT_DIR=./data
AGENT_NAME=solana-data-harvester

# ─────────────────────────────────────────────────────────────────────────
# DASHBOARD API
# ─────────────────────────────────────────────────────────────────────────
DASHBOARD_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000
